{
  "name": "brickwood-layout-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based overhead layout designer for Brickwood Builds LEGO exhibition displays.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "konva": "^10.9.0",
    "rbush": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
